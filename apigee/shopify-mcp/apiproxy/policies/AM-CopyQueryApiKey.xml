<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-CopyQueryApiKey">
  <DisplayName>Copy apikey query param</DisplayName>
  <Set>
    <Headers>
      <Header name="x-api-key">{request.queryparam.apikey}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
