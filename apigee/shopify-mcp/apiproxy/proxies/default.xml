<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description>Clients call this base path. Cloud Run is not on the public internet.</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-CopyQueryApiKey</Name>
        <Condition>(request.header.x-api-key = null or request.header.x-api-key = "") and (request.queryparam.apikey != null)</Condition>
      </Step>
      <Step>
        <Name>VerifyAPIKey-1</Name>
      </Step>
      <Step>
        <Name>SpikeArrest-Tier</Name>
      </Step>
      <Step>
        <Name>Quota-PerToolLimit</Name>
      </Step>
      <Step>
        <Name>JS-AuthorizeTool</Name>
      </Step>
      <Step>
        <Name>RF-ToolDenied</Name>
        <Condition>mcp.deny = "true"</Condition>
      </Step>
      <Step>
        <Name>AM-StripClientKey</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-FilterTools</Name>
      </Step>
    </Response>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/mcp</BasePath>
    <Properties>
      <Property name="request.streaming.enabled">false</Property>
      <Property name="response.streaming.enabled">false</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
